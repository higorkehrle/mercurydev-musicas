# MercuryDev Músicas — copy this file to `.env` (repository root) and fill it in.
# Only the server reads this file. Nothing here is ever sent to the browser.
# Never commit your real `.env`.

# ------------------------------------------------------------------ server
# API host/port. Use 127.0.0.1: Spotify does not accept "localhost" in Redirect URIs.
PORT=8787
HOST=127.0.0.1

# Origin where the browser opens the app.
#   npm run dev → http://127.0.0.1:5173 (Vite dev server)
#   npm start   → http://127.0.0.1:8787 (the server serves the production build)
WEB_ORIGIN=http://127.0.0.1:5173

# SQLite database file (lyrics/translation cache, history, favorites, offsets, encrypted tokens).
# Relative to the repository root. The `data/` folder is git-ignored.
DATABASE_PATH=data/lyricsync.db

# debug | info | warn | error
LOG_LEVEL=info

# Session cookie `Secure` flag. Default: true when NODE_ENV=production, false in dev.
# If you run the production build over plain http://127.0.0.1 and the browser drops the cookie, set false.
# COOKIE_SECURE=false

# 32-byte key used to encrypt Spotify tokens at rest (AES-256-GCM). Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------------ Spotify
# Where to get it: https://developer.spotify.com/dashboard → Create app → Settings → Client ID.
# The Client ID is public by design. There is NO client secret: the app uses
# Authorization Code with PKCE.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# Must match EXACTLY one of the "Redirect URIs" registered in the Dashboard.
# It points to the API server (PORT), not to Vite.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback

# ------------------------------------------------------------------ lyric translation
# deepl | anthropic | openai | none
#   deepl     → DeepL machine translation (no LLM). Key: https://www.deepl.com/your-account/keys
#               Free-plan keys end with ":fx" and automatically use api-free.deepl.com.
#   anthropic → Anthropic API (Claude). Key: https://console.anthropic.com/
#   openai    → any /chat/completions-compatible API (set TRANSLATION_BASE_URL and TRANSLATION_MODEL).
#   none      → the app works with the original lyrics only.
TRANSLATION_PROVIDER=none
TRANSLATION_API_KEY=
# Only for anthropic/openai. Default for anthropic: claude-opus-5-5
# TRANSLATION_MODEL=
# Only for TRANSLATION_PROVIDER=openai
# TRANSLATION_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------ lyrics (optional)
# Secondary provider, only if you have a LICENSED key for the official Musixmatch API.
# Without it the app uses LRCLIB only (https://lrclib.net).
MUSIXMATCH_API_KEY=

# Project URL included in the User-Agent sent to LRCLIB (optional, no personal data).
# APP_HOMEPAGE=https://github.com/your-user/mercurydev-musicas
